generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuctionStatus {
  UPCOMING
  LIVE
  CLOSED
  CANCELLED
}

enum Condition {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

enum PaymentProviderEnum {
  STRIPE
  RAZORPAY
  ETH
  SOL
  BTC
}

enum PaymentStatusEnum {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethodEnum {
  CRYPTO
  BANK_TRANSFER
  DEBIT_CARD
  CREDIT_CARD
}

enum EscrowStatus {
  PENDING
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
}

enum TransactionType {
  PAYMENT_TO_ESCROW
  ESCROW_TO_SELLER
  ESCROW_TO_BUYER
  PLATFORM_FEE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   
  name      String
  createdAt DateTime @default(now())

  addresses Address[]

  auctionsAsAuctioneer Auction[] @relation("Auctioneer")
  auctionsAsWinner     Auction[] @relation("Winner")

  items    Item[]
  bids     Bid[]
  payments Payment[]

  escrowsBuyer         Escrow[]      @relation("EscrowBuyer")
  escrowsSeller        Escrow[]      @relation("EscrowSeller")
  transactionsFromUser Transaction[] @relation("from")
  transactionsToUser   Transaction[] @relation("to")
}

model Address {
  id      Int    @id @default(autoincrement())
  userId  Int
  address String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Auction {
  id                  Int           @id @default(autoincrement())
  auctioneerId        Int
  winnerId            Int?
  itemId              Int
  description         String
  status              AuctionStatus @default(UPCOMING)
  condition           Condition
  startingTime        DateTime
  closingTime         DateTime
  startingBid         Int
  minimumBidIncrement Int
  softDeletedAt       DateTime?
  updatedAt           DateTime      @updatedAt
  createdAt           DateTime      @default(now())

  auctioneer User  @relation("Auctioneer", fields: [auctioneerId], references: [id])
  winner     User? @relation("Winner", fields: [winnerId], references: [id], onDelete: SetNull)
  item       Item  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  bids       Bid[]
}

model Item {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  name        String
  description String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  escrows  Escrow[]
  auctions Auction[]
}

model Bid {
  id        Int      @id @default(autoincrement())
  auctionId Int
  userId    Int
  bid       Int
  bidAt     DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Payment {
  id        Int                 @id @default(autoincrement())
  userId    Int
  provider  PaymentProviderEnum
  method    PaymentMethodEnum
  amount    Int
  status    PaymentStatusEnum
  createdAt DateTime            @default(now())

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id         Int             @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  escrowId   Int?
  paymentId  Int
  amount     Int
  type       TransactionType
  createdAt  DateTime        @default(now())

  fromUser User    @relation("from", fields: [fromUserId], references: [id])
  toUser   User    @relation("to", fields: [toUserId], references: [id])
  payment  Payment @relation(fields: [paymentId], references: [id])
}

model Escrow {
  id        Int          @id @default(autoincrement())
  amount    Int
  buyerId   Int
  sellerId  Int
  itemId    Int?
  status    EscrowStatus
  createdAt DateTime     @default(now())

  buyer  User  @relation("EscrowBuyer", fields: [buyerId], references: [id])
  seller User  @relation("EscrowSeller", fields: [sellerId], references: [id])
  item   Item? @relation(fields: [itemId], references: [id])
}
